{
  "name": "@bcn-services/bcns-client-technology-associates",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 tests/ai-optin.test.mjs tests/qa-hosted-web.test.mjs tests/rls-forbidden-read.test.mjs tests/foundation/*.test.mjs tests/migration/*.test.mjs tests/app-shell/*.test.mjs tests/cases/*.test.mjs tests/time/*.test.mjs tests/billing/*.test.mjs tests/money/*.test.mjs tests/docs-reports/*.test.mjs tests/billing-output/*.test.mjs tests/case-docs/*.test.mjs",
    "clean": "rm -rf .next .turbo node_modules",
    "test:foundation": "tsx --test --test-concurrency=1 tests/foundation/*.test.mjs",
    "db:types": "node scripts/gen-db-types.mjs > lib/db/types.ts",
    "typecheck:foundation": "tsc -p tsconfig.foundation.json",
    "test:journeys": "playwright test"
  },
  "dependencies": {
    "@bcn-services/app-core": "^0.2.0",
    "@bcn-services/ui": "^0.1.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.2",
    "next": "14.2.18",
    "pdf-lib": "1.17.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@bcn-services/config": "^0.1.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.15.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.23.1",
    "typescript": "^5.6.3"
  }
}
